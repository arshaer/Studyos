# StudyOS data and authentication
DATABASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
BLOB_READ_WRITE_TOKEN=

# Optional AI routes. Configure at least one route.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional self-hosted OmniRoute OpenAI-compatible endpoint.
# Quick Start default: http://localhost:20128/v1 (production must use a reachable HTTPS deployment).
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# Optional StudyOS routing controls
AI_PROVIDER=
AI_MAX_RETRIES=1

# Comma-separated Neon Auth user IDs allowed to access /admin (server-side only).
ADMIN_USER_IDS=

# Paid Professor routing is deliberately opt-in. Tutor and Flashcards ignore it.
PROFESSOR_PAID_ENABLED=false
PROFESSOR_PROVIDER=free
PROFESSOR_MODEL=
PROFESSOR_FALLBACK_PROVIDER=free
PROFESSOR_FALLBACK_MODEL=
